QUANTPILOT_DATA_DIR=data
QUANTPILOT_ARTIFACT_DIR=artifacts
QUANTPILOT_DATABASE_URL=sqlite:///data/quantpilot.db
QUANTPILOT_MARKET_HISTORY_YEARS=5
QUANTPILOT_MARKET_POLL_SECONDS=5
QUANTPILOT_WORKER_MAX_AGE_SECONDS=1800
# Optional directory containing matching pg_dump/pg_restore binaries:
# QUANTPILOT_POSTGRES_BIN=C:/Program Files/PostgreSQL/18/bin
# The local launcher creates private PostgreSQL settings automatically.
# QUANTPILOT_MARKET_DATABASE_URL=postgresql+psycopg://user:password@localhost:55432/quantpilot
# Docker Compose uses QUANTPILOT_PG_PASSWORD and QUANTPILOT_DOCKER_DATABASE_URL (host db).
QUANTPILOT_CORS_ORIGINS=["http://localhost:5173"]
# Supabase: use session pooler PostgreSQL URL with sslmode=require in deployment secrets.
# QUANTPILOT_DATABASE_URL=postgresql+psycopg://...
# Frontend build:
VITE_API_URL=http://localhost:8000

